FEICMS_DB=sqlite+aiosqlite:///data/feicms.db
FEICMS_SOURCES=sources.yaml
# 源订阅：逗号分隔的资源站列表 feed（json 或 txt），由你自己提供
# FEICMS_SUBSCRIPTIONS=https://<your-feed>/interfaces.json,https://<your-feed>/interfaces.txt
FEICMS_SUBSCRIPTIONS=
FEICMS_SUBSCRIBE_INTERVAL=1440
FEICMS_PAGES=5
FEICMS_PAGE_LIMIT=40
FEICMS_FULL_PAGE_CAP=200
FEICMS_CONCURRENCY=6
FEICMS_TIMEOUT=20
FEICMS_IMPERSONATE=chrome124
FEICMS_DELAY=0.3
FEICMS_RETRIES=3
FEICMS_AUTO_COLLECT=true
FEICMS_COLLECT_INTERVAL=60
FEICMS_HEALTH_INTERVAL=30
FEICMS_HEALTH_THRESHOLD=3
# 海报/图片本地化
FEICMS_IMAGE_DIR=data/images
FEICMS_IMAGE_BATCH=300
FEICMS_IMAGE_CONCURRENCY=8
FEICMS_IMAGE_DELAY=0.15
FEICMS_IMAGE_MAX_SIZE=2000000
FEICMS_IMAGE_AUTO=false
FEICMS_IMAGE_INTERVAL=30
FEICMS_HOST=0.0.0.0
FEICMS_PORT=8000
# 管理员登录（两者都设置才会启用认证；留空则 API 完全开放）
FEICMS_ADMIN_USER=admin
FEICMS_ADMIN_PASSWORD=
# token 签名密钥（留空则用 user+password 派生）
FEICMS_SECRET=
FEICMS_TOKEN_TTL=86400
# /provide/vod 是否允许匿名访问（下游 CMS 采集用）
FEICMS_PUBLIC_PROVIDE=true
